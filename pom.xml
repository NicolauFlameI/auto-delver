<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Coordenadas Maven do Projeto Auto-Delver -->
    <groupId>com.nicolas</groupId>
    <artifactId>auto-delver</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <properties>
        <!-- Forca codificacao UTF-8 para evitar problemas de caracteres em diferentes SOs -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Configura a release para compilar nativamente em Java 21 -->
        <maven.compiler.release>21</maven.compiler.release>
        <!-- NOVO: versao do libGDX em um unico lugar; as 3 dependencias abaixo a reutilizam.
             Para atualizar o libGDX no futuro, basta mudar esta linha. -->
        <gdx.version>1.14.2</gdx.version>
    </properties>

    <dependencies>
        <!-- Driver JDBC do PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>

        <!-- NOVO: nucleo do libGDX (API de desenho, input, assets, matematica) -->
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx</artifactId>
            <version>${gdx.version}</version>
        </dependency>

        <!-- NOVO: backend desktop (LWJGL3). Cria a janela e o contexto OpenGL no PC. -->
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-backend-lwjgl3</artifactId>
            <version>${gdx.version}</version>
        </dependency>

        <!-- NOVO: bibliotecas nativas (.so/.dll/.dylib) que o libGDX usa no desktop.
             O classifier "natives-desktop" traz os binarios de Linux, Windows e macOS. -->
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-platform</artifactId>
            <version>${gdx.version}</version>
            <classifier>natives-desktop</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin padrao de compilacao do Maven configurado para o Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <compilerArgs>
                        <arg>-Xlint:unchecked</arg>
                        <arg>-Xlint:rawtypes</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>